{
  "name": "@personal/shared",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "DOM-free code shared by the web and mobile apps: the generated API client, the configured client, server-state queries, client-state stores and helpers.",
  "exports": {
    "./generated/api": "./src/generated/api/index.ts",
    "./generated/api/runtime": "./src/generated/api/runtime.ts",
    "./stores/*": "./src/stores/*.ts",
    "./queries/*": "./src/queries/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/query-async-storage-persister": "^5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "react": "19.3.0",
    "zustand": "^5.0.15"
  }
}
