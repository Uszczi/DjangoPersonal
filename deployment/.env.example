# The site's domain, without a scheme. deploy.sh refuses to run without it and
# substitutes it for [[DOMAIN]] in deployment/nginx/*.conf.
DOMAIN=[[DOMAIN]]

# Application (API and MCP server). deploy.sh refuses to run without SECRET_KEY.
SECRET_KEY=replace-me
DEBUG=0
# Signs the admin panel's session cookie (deploy.sh refuses to run without it).
ADMIN_SECRET_KEY=replace-me
# The compose file appends `,app` / `,mcp` automatically for in-network calls.
ALLOWED_HOSTS=[[DOMAIN]],www.[[DOMAIN]],localhost,127.0.0.1

# Number of uvicorn workers (metrics are aggregated across all of them).
UVICORN_WORKERS=2

# OpenTelemetry: the API, MCP server and admin panel send traces over OTLP/HTTP
# to Alloy, which forwards them to Tempo. Unset, the compose file uses Alloy;
# set it empty to turn tracing off.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318

# Redis for the login rate limits (the compose file defaults to the redis
# service). Unset outside Docker: each process then counts in its own memory.
REDIS_URL=redis://redis:6379/0

# Answering questions about Notatki (POST /api/v1/notes/ask/, MCP ask_notes).
# Embeddings come from Ollama; answers from any OpenAI-compatible chat API.
# Without LLM_MODEL, questions fail with 503 and the rest of the app works.
# Inside a container localhost is the container itself: point both URLs at
# the host or an Ollama service when one is deployed.
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=embeddinggemma-2:270m
NOTES_MIN_SCORE=0.65
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=

# Postgres (must match the db service in docker-compose.yml). The db container
# creates POSTGRES_DB on a fresh volume; Alembic creates the tables.
POSTGRES_DB=djangopersonal_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=supersecret

# Backups (the backup service, deployment/backup/). Daily pg_dump at
# BACKUP_TIME (UTC) into BACKUP_DIR on the host: 7 daily, 4 weekly, 6 monthly.
BACKUP_TIME=03:00
BACKUP_DIR=/var/backups/djangopersonal
# Offsite copy with restic to any S3-compatible bucket (Backblaze B2, Hetzner,
# R2, ...), encrypted with RESTIC_PASSWORD; leave RESTIC_REPOSITORY empty to
# keep the dumps on the VPS only. Keep RESTIC_PASSWORD somewhere besides this
# file too: without it the offsite copies cannot be read.
# Google Cloud Storage works through its S3 interface: a Standard-class bucket
# (restic prunes daily, which Nearline/Coldline charge extra for), a service
# account with Storage Object Admin on it, and an HMAC key for that account
# (Cloud Storage → Settings → Interoperability). The AWS_* names are what
# restic's S3 client reads, whatever the provider:
#   RESTIC_REPOSITORY=s3:https://storage.googleapis.com/<bucket>/djangopersonal
#   AWS_ACCESS_KEY_ID=<HMAC access id, e.g. GOOG1E...>
#   AWS_SECRET_ACCESS_KEY=<HMAC secret>
# For Backblaze B2 they are the application key's keyID and applicationKey.
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/<bucket>/djangopersonal
RESTIC_PASSWORD=replace-me
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-me

MCP_ISSUER_URL=https://[[DOMAIN]]
MCP_PUBLIC_HOST=[[DOMAIN]]
