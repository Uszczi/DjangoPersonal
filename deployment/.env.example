# The site's domain, without a scheme. deploy.sh refuses to run without it and
# substitutes it for [[DOMAIN]] in deployment/nginx/*.conf.
DOMAIN=[[DOMAIN]]

# Application (API and MCP server). deploy.sh refuses to run without SECRET_KEY.
SECRET_KEY=replace-me
DEBUG=0
# Signs the admin panel's session cookie (deploy.sh refuses to run without it).
ADMIN_SECRET_KEY=replace-me
# The compose file appends `,app` / `,mcp` automatically for in-network calls.
ALLOWED_HOSTS=[[DOMAIN]],www.[[DOMAIN]],localhost,127.0.0.1

# Number of uvicorn workers (metrics are aggregated across all of them).
UVICORN_WORKERS=2

# OpenTelemetry: the API, MCP server and admin panel send traces over OTLP/HTTP
# to Alloy, which forwards them to Tempo. Unset, the compose file uses Alloy;
# set it empty to turn tracing off.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318

# Redis for the login rate limits (the compose file defaults to the redis
# service). Unset outside Docker: each process then counts in its own memory.
REDIS_URL=redis://redis:6379/0

# Postgres (must match the db service in docker-compose.yml). The db container
# creates POSTGRES_DB on a fresh volume; Alembic creates the tables.
POSTGRES_DB=djangopersonal_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=supersecret

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-me

MCP_ISSUER_URL=https://[[DOMAIN]]
MCP_PUBLIC_HOST=[[DOMAIN]]
